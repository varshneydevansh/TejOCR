<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="TejOCRSettingsDialog" dlg:left="100" dlg:top="40" dlg:width="470" dlg:height="460" dlg:closeable="true" dlg:moveable="true" dlg:title="TejOCR Settings">
  <dlg:bulletinboard>

    <!-- === Dependency Status === -->
    <dlg:fixedline dlg:id="SectionDependency" dlg:tab-index="0" dlg:left="10" dlg:top="6" dlg:width="450" dlg:height="10" dlg:value="System Readiness"/>
    <dlg:text dlg:id="TesseractStatusLabel" dlg:tab-index="1" dlg:left="20" dlg:top="20" dlg:width="165" dlg:height="10" dlg:value="Tesseract: Checking..."/>
    <dlg:text dlg:id="PdfStatusLabel" dlg:tab-index="2" dlg:left="195" dlg:top="20" dlg:width="55" dlg:height="10" dlg:value="PDF: ..."/>
    <dlg:text dlg:id="PythonPackagesStatusLabel" dlg:tab-index="3" dlg:left="260" dlg:top="20" dlg:width="200" dlg:height="10" dlg:value="Extras: Checking..."/>
    <dlg:button dlg:id="SetupButton" dlg:tab-index="4" dlg:left="20" dlg:top="34" dlg:width="140" dlg:height="16" dlg:value="Setup &amp; Diagnostics..."/>
    
    <!-- Secondary Community Tiles -->
    <dlg:button dlg:id="WikiButton" dlg:tab-index="5" dlg:left="170" dlg:top="34" dlg:width="120" dlg:height="16" dlg:value="Open TejOCR Wiki"/>
    <dlg:button dlg:id="FilterTubeButton" dlg:tab-index="6" dlg:left="300" dlg:top="34" dlg:width="160" dlg:height="16" dlg:value="FilterTube.in (Free Open Source)"/>
    <dlg:text dlg:id="FilterTubeTagline2" dlg:tab-index="7" dlg:left="300" dlg:top="52" dlg:width="160" dlg:height="10" dlg:value="  Block/ WHITELIST Anything on YouTube"/>

    <!-- === Tesseract Configuration === -->
    <dlg:fixedline dlg:id="SectionPath" dlg:tab-index="8" dlg:left="10" dlg:top="56" dlg:width="450" dlg:height="10" dlg:value="Tesseract Engine Path"/>
    <dlg:text dlg:id="TesseractPathLabel" dlg:tab-index="9" dlg:left="20" dlg:top="70" dlg:width="410" dlg:height="10" dlg:value="Executable path (leave blank for automatic detection):"/>
    <dlg:textfield dlg:id="TesseractPathTextField" dlg:tab-index="10" dlg:left="20" dlg:top="82" dlg:width="360" dlg:height="14"/>
    <dlg:button dlg:id="BrowseButton" dlg:tab-index="11" dlg:left="385" dlg:top="81" dlg:width="35" dlg:height="16" dlg:value="..."/>
    <dlg:button dlg:id="TestTesseractButton" dlg:tab-index="12" dlg:left="425" dlg:top="81" dlg:width="35" dlg:height="16" dlg:value="Test"/>
    <dlg:text dlg:id="TesseractTestStatusLabel" dlg:tab-index="13" dlg:left="20" dlg:top="100" dlg:width="430" dlg:height="10" dlg:value=""/>

    <!-- === OCR Languages === -->
    <dlg:fixedline dlg:id="SectionLanguage" dlg:tab-index="14" dlg:left="10" dlg:top="114" dlg:width="450" dlg:height="10" dlg:value="OCR Languages (Cmd/Ctrl + click to combine multiple)"/>
    <dlg:text dlg:id="SearchLabel" dlg:tab-index="15" dlg:left="20" dlg:top="130" dlg:width="40" dlg:height="10" dlg:value="Search:"/>
    <dlg:textfield dlg:id="LanguageSearchField" dlg:tab-index="16" dlg:left="60" dlg:top="128" dlg:width="240" dlg:height="14"/>
    <dlg:button dlg:id="SearchLanguagesButton" dlg:tab-index="17" dlg:left="305" dlg:top="127" dlg:width="55" dlg:height="16" dlg:value="Search"/>
    <dlg:button dlg:id="RefreshLanguagesButtonSettings" dlg:tab-index="18" dlg:left="365" dlg:top="127" dlg:width="85" dlg:height="16" dlg:value="Refresh List"/>
    <dlg:menulist dlg:id="LanguagesListbox" dlg:tab-index="19" dlg:left="20" dlg:top="146" dlg:width="430" dlg:height="70" dlg:multiselection="true"/>
    <dlg:text dlg:id="SelectedLangsLabel" dlg:tab-index="20" dlg:left="20" dlg:top="220" dlg:width="430" dlg:height="10" dlg:value="Selected: (none)"/>

    <!-- === Quality Presets & Output Mode === -->
    <dlg:fixedline dlg:id="SectionOutput" dlg:tab-index="21" dlg:left="10" dlg:top="234" dlg:width="450" dlg:height="10" dlg:value="Default Quality &amp; Insertion Settings"/>
    
    <dlg:text dlg:id="DefaultPresetLabel" dlg:tab-index="32" dlg:left="20" dlg:top="248" dlg:width="30" dlg:height="12" dlg:value="Preset:"/>
    <dlg:text dlg:id="PresetStatusLabel" dlg:tab-index="36" dlg:left="55" dlg:top="248" dlg:width="120" dlg:height="60" dlg:multiline="true" dlg:value=""/>
    <dlg:menulist dlg:id="DefaultPresetDropdown" dlg:tab-index="35" dlg:left="20" dlg:top="270" dlg:width="150" dlg:height="44" dlg:dropdown="false"/>

    <dlg:text dlg:id="OutputModeLabel" dlg:tab-index="22" dlg:left="190" dlg:top="248" dlg:width="50" dlg:height="10" dlg:value="Output:"/>
    <dlg:radiogroup>
      <dlg:radio dlg:id="OutputRadioCursor" dlg:tab-index="23" dlg:left="190" dlg:top="262" dlg:width="120" dlg:height="12" dlg:value="Insert at cursor" dlg:checked="true"/>
      <dlg:radio dlg:id="OutputRadioTextBox" dlg:tab-index="24" dlg:left="190" dlg:top="276" dlg:width="120" dlg:height="12" dlg:value="Create text box"/>
      <dlg:radio dlg:id="OutputRadioReplace" dlg:tab-index="25" dlg:left="320" dlg:top="262" dlg:width="120" dlg:height="12" dlg:value="Replace image"/>
      <dlg:radio dlg:id="OutputRadioClipboard" dlg:tab-index="26" dlg:left="320" dlg:top="276" dlg:width="120" dlg:height="12" dlg:value="Copy to clipboard"/>
    </dlg:radiogroup>

    <!-- Preprocessing Checkboxes -->
    <dlg:checkbox dlg:id="DefaultGrayscaleCheckbox" dlg:tab-index="27" dlg:left="20" dlg:top="320" dlg:width="160" dlg:height="12" dlg:value="Grayscale filter"/>
    <dlg:checkbox dlg:id="DefaultBinarizeCheckbox" dlg:tab-index="28" dlg:left="20" dlg:top="334" dlg:width="160" dlg:height="12" dlg:value="Binarize (BW)"/>
    <dlg:checkbox dlg:id="DefaultPreviewCheckbox" dlg:tab-index="29" dlg:left="190" dlg:top="320" dlg:width="240" dlg:height="12" dlg:value="Preview OCR text before insert"/>
    <dlg:checkbox dlg:id="DefaultMergeBatchCheckbox" dlg:tab-index="30" dlg:left="190" dlg:top="334" dlg:width="240" dlg:height="12" dlg:value="Merge bulk/PDF into single output"/>
    <dlg:text dlg:id="MergeStatusLabel" dlg:tab-index="31" dlg:left="190" dlg:top="348" dlg:width="260" dlg:height="10" dlg:value=""/>

    <!-- === Tesseract Parameters === -->
    <dlg:fixedline dlg:id="SectionParams" dlg:tab-index="32" dlg:left="10" dlg:top="366" dlg:width="450" dlg:height="10" dlg:value="Engine Performance Tuning"/>
    
    <dlg:button dlg:id="AdvancedParamsButton" dlg:tab-index="33" dlg:left="20" dlg:top="380" dlg:width="250" dlg:height="20" dlg:value="Advanced Engine Parameters (Custom Preset Only)..."/>

    <!-- === Footer === -->
    <dlg:fixedline dlg:id="SectionFooter" dlg:tab-index="38" dlg:left="10" dlg:top="406" dlg:width="450" dlg:height="10"/>
    <dlg:text dlg:id="SettingsStatusLabel" dlg:tab-index="39" dlg:left="10" dlg:top="418" dlg:width="450" dlg:height="10" dlg:value="Ready"/>
    <dlg:button dlg:id="HelpButtonSettings" dlg:tab-index="40" dlg:left="10" dlg:top="430" dlg:width="55" dlg:height="22" dlg:value="Help..."/>
    <dlg:button dlg:id="MessageButtonSettings" dlg:tab-index="41" dlg:left="72" dlg:top="430" dlg:width="82" dlg:height="22" dlg:value="A Message"/>
    <dlg:button dlg:id="CancelButton" dlg:tab-index="42" dlg:left="345" dlg:top="430" dlg:width="60" dlg:height="22" dlg:value="Cancel"/>
    <dlg:button dlg:id="SaveButton" dlg:tab-index="43" dlg:left="410" dlg:top="430" dlg:width="50" dlg:height="22" dlg:default="true" dlg:value="Save"/>

  </dlg:bulletinboard>
</dlg:window>
