<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="TejOCRSetupDialog" dlg:left="120" dlg:top="80" dlg:width="340" dlg:height="260" dlg:closeable="true" dlg:moveable="true" dlg:title="TejOCR — Setup &amp; Diagnostics">
  <dlg:bulletinboard>

    <!-- === Component Status Section === -->
    <dlg:fixedline dlg:id="SectionStatus" dlg:tab-index="0" dlg:left="10" dlg:top="6" dlg:width="320" dlg:height="10" dlg:value="Component Status"/>
    <dlg:text dlg:id="TesseractRow" dlg:tab-index="1" dlg:left="20" dlg:top="22" dlg:width="300" dlg:height="10" dlg:value="Checking..."/>
    <dlg:text dlg:id="NumpyRow" dlg:tab-index="2" dlg:left="20" dlg:top="36" dlg:width="300" dlg:height="10" dlg:value="Checking..."/>
    <dlg:text dlg:id="PytesseractRow" dlg:tab-index="3" dlg:left="20" dlg:top="50" dlg:width="300" dlg:height="10" dlg:value="Checking..."/>
    <dlg:text dlg:id="PillowRow" dlg:tab-index="4" dlg:left="20" dlg:top="64" dlg:width="300" dlg:height="10" dlg:value="Checking..."/>
    <dlg:text dlg:id="UnoRow" dlg:tab-index="5" dlg:left="20" dlg:top="78" dlg:width="300" dlg:height="10" dlg:value="Checking..."/>

    <!-- === Install Instructions Section === -->
    <dlg:fixedline dlg:id="SectionInstall" dlg:tab-index="6" dlg:left="10" dlg:top="96" dlg:width="320" dlg:height="10" dlg:value="Install Instructions"/>
    <dlg:textfield dlg:id="InstallCommandField" dlg:tab-index="7" dlg:left="20" dlg:top="112" dlg:width="300" dlg:height="80" dlg:multiline="true" dlg:readonly="true" dlg:vscroll="true"/>

    <!-- === Action Buttons === -->
    <dlg:fixedline dlg:id="SectionActions" dlg:tab-index="8" dlg:left="10" dlg:top="200" dlg:width="320" dlg:height="10"/>
    <dlg:button dlg:id="CopyCommandButton" dlg:tab-index="9" dlg:left="20" dlg:top="218" dlg:width="90" dlg:height="20" dlg:value="Copy Command"/>
    <dlg:button dlg:id="ReCheckButton" dlg:tab-index="10" dlg:left="120" dlg:top="218" dlg:width="90" dlg:height="20" dlg:value="Re-Check"/>
    <dlg:button dlg:id="CloseSetupButton" dlg:tab-index="11" dlg:left="260" dlg:top="218" dlg:width="60" dlg:height="20" dlg:button-type="cancel" dlg:value="Close"/>

  </dlg:bulletinboard>
</dlg:window>
