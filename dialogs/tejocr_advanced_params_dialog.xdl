<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="TejOCRAdvancedParamsDialog" dlg:left="150" dlg:top="100" dlg:width="420" dlg:height="244" dlg:closeable="true" dlg:moveable="true" dlg:title="Advanced Engine Parameters">
  <dlg:bulletinboard>
    <dlg:text dlg:id="PSMLabel" dlg:tab-index="0" dlg:left="10" dlg:top="10" dlg:width="300" dlg:height="12" dlg:value="Page Segmentation Mode (PSM):"/>
    <dlg:menulist dlg:id="PSMDropdown" dlg:tab-index="1" dlg:left="10" dlg:top="24" dlg:width="400" dlg:height="75" dlg:dropdown="false"/>
    
    <dlg:text dlg:id="OEMLabel" dlg:tab-index="2" dlg:left="10" dlg:top="106" dlg:width="300" dlg:height="12" dlg:value="OCR Engine Mode (OEM):"/>
    <dlg:menulist dlg:id="OEMDropdown" dlg:tab-index="3" dlg:left="10" dlg:top="120" dlg:width="400" dlg:height="75" dlg:dropdown="false"/>
    
    <dlg:fixedline dlg:id="SectionFooter" dlg:tab-index="4" dlg:left="10" dlg:top="202" dlg:width="400" dlg:height="10"/>
    <dlg:text dlg:id="ParamsWarningLabel" dlg:tab-index="5" dlg:left="10" dlg:top="216" dlg:width="220" dlg:height="22" dlg:multiline="true" dlg:value="Warning: Incorrect settings may break OCR."/>
    <dlg:button dlg:id="CancelButtonParams" dlg:tab-index="6" dlg:left="250" dlg:top="214" dlg:width="70" dlg:height="22" dlg:value="Cancel"/>
    <dlg:button dlg:id="SaveButtonParams" dlg:tab-index="7" dlg:left="330" dlg:top="214" dlg:width="80" dlg:height="22" dlg:default="true" dlg:value="Use Settings"/>
  </dlg:bulletinboard>
</dlg:window>
