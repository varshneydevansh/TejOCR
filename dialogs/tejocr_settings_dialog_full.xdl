<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="TejOCRSettingsDialog" dlg:left="100" dlg:top="40" dlg:width="380" dlg:height="400" dlg:closeable="true" dlg:moveable="true" dlg:title="TejOCR Settings">
  <dlg:bulletinboard>

    <!-- === Dependency Status === -->
    <dlg:fixedline dlg:id="SectionDependency" dlg:tab-index="0" dlg:left="10" dlg:top="6" dlg:width="360" dlg:height="10" dlg:value="Dependency Status"/>
    <dlg:text dlg:id="TesseractStatusLabel" dlg:tab-index="1" dlg:left="20" dlg:top="20" dlg:width="160" dlg:height="10" dlg:value="Tesseract: Checking..."/>
    <dlg:text dlg:id="PythonPackagesStatusLabel" dlg:tab-index="2" dlg:left="190" dlg:top="20" dlg:width="170" dlg:height="10" dlg:value="Python: Checking..."/>
    <dlg:button dlg:id="SetupButton" dlg:tab-index="3" dlg:left="20" dlg:top="34" dlg:width="130" dlg:height="16" dlg:value="Setup &amp; Diagnostics..."/>
    <dlg:button dlg:id="WikiButton" dlg:tab-index="4" dlg:left="160" dlg:top="34" dlg:width="110" dlg:height="16" dlg:value="Open TejOCR Wiki"/>

    <!-- === Tesseract Configuration === -->
    <dlg:fixedline dlg:id="SectionPath" dlg:tab-index="5" dlg:left="10" dlg:top="58" dlg:width="360" dlg:height="10" dlg:value="Tesseract Configuration"/>
    <dlg:text dlg:id="TesseractPathLabel" dlg:tab-index="6" dlg:left="20" dlg:top="72" dlg:width="320" dlg:height="10" dlg:value="Executable path (blank = auto-detect):"/>
    <dlg:textfield dlg:id="TesseractPathTextField" dlg:tab-index="7" dlg:left="20" dlg:top="84" dlg:width="270" dlg:height="14"/>
    <dlg:button dlg:id="BrowseButton" dlg:tab-index="8" dlg:left="295" dlg:top="83" dlg:width="35" dlg:height="16" dlg:value="..."/>
    <dlg:button dlg:id="TestTesseractButton" dlg:tab-index="9" dlg:left="335" dlg:top="83" dlg:width="35" dlg:height="16" dlg:value="Test"/>
    <dlg:text dlg:id="TesseractTestStatusLabel" dlg:tab-index="10" dlg:left="20" dlg:top="102" dlg:width="340" dlg:height="10" dlg:value=""/>

    <!-- === OCR Languages === -->
    <dlg:fixedline dlg:id="SectionLanguage" dlg:tab-index="11" dlg:left="10" dlg:top="118" dlg:width="360" dlg:height="10" dlg:value="OCR Languages (Cmd/Ctrl + click for multi-select)"/>
    <dlg:text dlg:id="SearchLabel" dlg:tab-index="12" dlg:left="20" dlg:top="134" dlg:width="40" dlg:height="10" dlg:value="Search:"/>
    <dlg:textfield dlg:id="LanguageSearchField" dlg:tab-index="13" dlg:left="60" dlg:top="132" dlg:width="165" dlg:height="14"/>
    <dlg:button dlg:id="SearchLanguagesButton" dlg:tab-index="14" dlg:left="228" dlg:top="131" dlg:width="55" dlg:height="16" dlg:value="Search"/>
    <dlg:button dlg:id="RefreshLanguagesButtonSettings" dlg:tab-index="15" dlg:left="290" dlg:top="131" dlg:width="80" dlg:height="16" dlg:value="Refresh List"/>
    <dlg:menulist dlg:id="LanguagesListbox" dlg:tab-index="16" dlg:left="20" dlg:top="150" dlg:width="350" dlg:height="70" dlg:multiselection="true"/>
    <dlg:text dlg:id="SelectedLangsLabel" dlg:tab-index="17" dlg:left="20" dlg:top="224" dlg:width="350" dlg:height="10" dlg:value="Selected: (none)"/>

    <!-- === Output & Preprocessing === -->
    <dlg:fixedline dlg:id="SectionOutput" dlg:tab-index="18" dlg:left="10" dlg:top="240" dlg:width="360" dlg:height="10" dlg:value="Output &amp; Preprocessing"/>
    <dlg:text dlg:id="OutputModeLabel" dlg:tab-index="19" dlg:left="20" dlg:top="256" dlg:width="50" dlg:height="10" dlg:value="Output:"/>
    <dlg:radiogroup>
      <dlg:radio dlg:id="OutputRadioCursor" dlg:tab-index="20" dlg:left="70" dlg:top="255" dlg:width="120" dlg:height="12" dlg:value="Insert at cursor" dlg:checked="true"/>
      <dlg:radio dlg:id="OutputRadioTextBox" dlg:tab-index="21" dlg:left="200" dlg:top="255" dlg:width="150" dlg:height="12" dlg:value="Create a new text box"/>
      <dlg:radio dlg:id="OutputRadioReplace" dlg:tab-index="22" dlg:left="70" dlg:top="269" dlg:width="120" dlg:height="12" dlg:value="Replace image"/>
      <dlg:radio dlg:id="OutputRadioClipboard" dlg:tab-index="23" dlg:left="200" dlg:top="269" dlg:width="150" dlg:height="12" dlg:value="Copy to clipboard"/>
    </dlg:radiogroup>
    <dlg:checkbox dlg:id="DefaultGrayscaleCheckbox" dlg:tab-index="24" dlg:left="20" dlg:top="290" dlg:width="140" dlg:height="12" dlg:value="Grayscale filter"/>
    <dlg:checkbox dlg:id="DefaultBinarizeCheckbox" dlg:tab-index="25" dlg:left="200" dlg:top="290" dlg:width="150" dlg:height="12" dlg:value="Binarize (black/white)"/>

    <!-- === Footer === -->
    <dlg:fixedline dlg:id="SectionFooter" dlg:tab-index="26" dlg:left="10" dlg:top="310" dlg:width="360" dlg:height="10"/>
    <dlg:text dlg:id="SettingsStatusLabel" dlg:tab-index="27" dlg:left="10" dlg:top="326" dlg:width="360" dlg:height="10" dlg:value="Ready"/>
    <dlg:button dlg:id="HelpButtonSettings" dlg:tab-index="28" dlg:left="10" dlg:top="342" dlg:width="55" dlg:height="22" dlg:value="Help..."/>
    <dlg:button dlg:id="CancelButton" dlg:tab-index="29" dlg:left="245" dlg:top="342" dlg:width="60" dlg:height="22" dlg:value="Cancel"/>
    <dlg:button dlg:id="SaveButton" dlg:tab-index="30" dlg:left="310" dlg:top="342" dlg:width="60" dlg:height="22" dlg:default="true" dlg:value="Save"/>

  </dlg:bulletinboard>
</dlg:window>
