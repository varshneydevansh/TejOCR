<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="TejOCROptionsDialog" dlg:left="120" dlg:top="88" dlg:width="420" dlg:height="300" dlg:closeable="true" dlg:moveable="true" dlg:title="OCR Options">
  <dlg:bulletinboard>
    <dlg:text dlg:id="HeaderLabel" dlg:tab-index="0" dlg:left="10" dlg:top="6" dlg:width="390" dlg:height="12" dlg:value="TejOCR - OCR Options"/>
    <dlg:text dlg:id="SourceDescriptionLabel" dlg:tab-index="1" dlg:left="10" dlg:top="22" dlg:width="390" dlg:height="12" dlg:value="Source: selected image"/>
    <dlg:button dlg:id="RefreshLanguagesButton" dlg:tab-index="2" dlg:left="340" dlg:top="20" dlg:width="70" dlg:height="16" dlg:value="Refresh"/>

    <dlg:text dlg:id="LanguageLabel" dlg:tab-index="3" dlg:left="10" dlg:top="44" dlg:width="90" dlg:height="10" dlg:value="Language:"/>
    <dlg:combobox dlg:id="LanguageDropdown" dlg:tab-index="4" dlg:left="100" dlg:top="42" dlg:width="190" dlg:height="12"/>
    <dlg:text dlg:id="LanguageHelpLabel" dlg:tab-index="5" dlg:left="10" dlg:top="60" dlg:width="400" dlg:height="10" dlg:value="Choose OCR language code for better results."/>

    <dlg:text dlg:id="OutputModeLabel" dlg:tab-index="6" dlg:left="10" dlg:top="80" dlg:width="90" dlg:height="10" dlg:value="Output Mode:"/>
    <dlg:radiogroup>
      <dlg:radio dlg:id="OutputAtCursorRadio" dlg:tab-index="7" dlg:left="100" dlg:top="78" dlg:width="150" dlg:height="12" dlg:value="cursor" dlg:checked="true"/>
      <dlg:radio dlg:id="OutputNewTextboxRadio" dlg:tab-index="8" dlg:left="100" dlg:top="92" dlg:width="150" dlg:height="12" dlg:value="textbox"/>
      <dlg:radio dlg:id="OutputReplaceImageRadio" dlg:tab-index="9" dlg:left="260" dlg:top="78" dlg:width="150" dlg:height="12" dlg:value="replace"/>
      <dlg:radio dlg:id="OutputToClipboardRadio" dlg:tab-index="10" dlg:left="260" dlg:top="92" dlg:width="150" dlg:height="12" dlg:value="clipboard"/>
    </dlg:radiogroup>

    <dlg:text dlg:id="PreprocessLabel" dlg:tab-index="11" dlg:left="10" dlg:top="120" dlg:width="90" dlg:height="10" dlg:value="Preprocess:"/>
    <dlg:checkbox dlg:id="GrayscaleCheckbox" dlg:tab-index="12" dlg:left="100" dlg:top="118" dlg:width="135" dlg:height="12" dlg:value="Grayscale"/>
    <dlg:checkbox dlg:id="BinarizeCheckbox" dlg:tab-index="13" dlg:left="235" dlg:top="118" dlg:width="140" dlg:height="12" dlg:value="Binarize"/>

    <dlg:text dlg:id="PSMLabel" dlg:tab-index="14" dlg:left="10" dlg:top="144" dlg:width="70" dlg:height="10" dlg:value="PSM:"/>
    <dlg:combobox dlg:id="PSMDropdown" dlg:tab-index="15" dlg:left="100" dlg:top="142" dlg:width="120" dlg:height="12"/>
    <dlg:text dlg:id="OEMLabel" dlg:tab-index="16" dlg:left="230" dlg:top="144" dlg:width="70" dlg:height="10" dlg:value="OEM:"/>
    <dlg:combobox dlg:id="OEMDropdown" dlg:tab-index="17" dlg:left="295" dlg:top="142" dlg:width="110" dlg:height="12"/>

    <dlg:text dlg:id="StatusLabel" dlg:tab-index="18" dlg:left="10" dlg:top="166" dlg:width="400" dlg:height="12" dlg:value="Ready"/>

    <dlg:button dlg:id="HelpButton" dlg:tab-index="19" dlg:left="250" dlg:top="264" dlg:width="60" dlg:height="24" dlg:value="Help"/>
    <dlg:button dlg:id="CancelButton" dlg:tab-index="20" dlg:left="315" dlg:top="264" dlg:width="60" dlg:height="24" dlg:button-type="cancel" dlg:value="Cancel"/>
    <dlg:button dlg:id="RunOCRButton" dlg:tab-index="21" dlg:left="380" dlg:top="264" dlg:width="30" dlg:height="24" dlg:button-type="ok" dlg:default="true" dlg:value="Start"/>
  </dlg:bulletinboard>
</dlg:window>
